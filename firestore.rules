rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "REPLACE_WITH_ADMIN_EMAIL";
    }
    match /registrations/{registrationId} {
      allow read: if isAdmin();
      allow create, delete: if false; // Public writes go through the Cloud Function only.
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["paymentStatus", "reviewedAt"]) &&
        request.resource.data.paymentStatus in ["pending", "received", "rejected"];
    }
  }
}